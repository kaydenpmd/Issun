<Application x:Class="Issun.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <!-- No main window here: App.OnLaunched decides whether there is a window
         at all (background starts in the tray, a screenshot never shows one).

         The theme follows Windows' light or dark mode and accent colour unless
         the theme option forces one (App's constructor). Every brush below is a
         ThemeResource, so it follows a switch Windows makes while Issun runs.
         The type sizes are WinUI's own type ramp, which the WPF build copied
         by hand: Body 14, Caption 12, Body Strong 14 semibold, Title 28. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The toolkit's SettingsCard resources, so the cards that
                     can't be SettingsCards (a picture or a field below the
                     title, a status dot) take its padding, height and colours
                     by name. -->
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsCard/SettingsCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- A card that isn't a SettingsCard (it has a picture or a field
                 under its title, or a status dot), drawn with SettingsCard's own
                 resources so it sits among them as one of them. 4 apart, as
                 Windows 11 Settings' cards are (measured, design library
                 microsoft/windows11-settings-cards). -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SettingsCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource SettingsCardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="{ThemeResource SettingsCardPadding}" />
                <Setter Property="MinHeight" Value="{ThemeResource SettingsCardMinHeight}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- A SettingsCard in a list of them: 4 apart, as above. -->
            <Style x:Key="Row" TargetType="tk:SettingsCard">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,22,0,8" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="RowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="MonoBlock" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="False" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- The dot beside each status row: Views/StatusDot. -->
            <Style x:Key="StatusDotPlace" TargetType="FrameworkElement">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,6,14,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
