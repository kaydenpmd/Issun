<Application x:Class="Issun.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No main window here: App.OnLaunched decides whether there is a window
         at all (background starts in the tray, a screenshot never shows one).

         The theme follows Windows' light or dark mode and accent colour unless
         the theme option forces one (App's constructor). Every brush below is a
         ThemeResource, so it follows a switch Windows makes while Issun runs.
         The type sizes are WinUI's own type ramp, which the WPF build copied
         by hand: Body 14, Caption 12, Body Strong 14 semibold, Title 28. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- Windows 11 Settings-style card: a slightly lifted layer over Mica. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- A card that is itself a button, as Windows 11 Settings' cards
                 that open another page. Measured on Windows 11 26H2's Settings,
                 System page, at 96 dpi (design library,
                 microsoft/windows11-settings-cards): 68 px tall, padding 16, 4 px
                 apart (the Card margin), the card fill at rest and the secondary
                 control fill on hover (5% and 8% white in dark mode, as
                 measured). Pressed uses the tertiary fill, not measured. Drawn
                 here rather than taken from the Windows Community Toolkit's
                 SettingsCard: the toolkit's stable release (8.2) is built on
                 Windows App SDK 1.6 and pulls in its whole metapackage beside
                 Issun's 2.6. -->
            <Style x:Key="NavigationCard" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Bg" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                  MinHeight="{TemplateBinding MinHeight}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Bg.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Bg.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,22,0,8" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="RowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="MonoBlock" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="False" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- The dot beside each status row: Views/StatusDot. -->
            <Style x:Key="StatusDotPlace" TargetType="FrameworkElement">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,6,14,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
