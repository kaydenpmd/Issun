<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 (Windows App SDK) since 12 Nov 2026, the owner's decision ("let's
       move to winui 3 actually"); WPF before that. The winui3-spike branch's
       spike/winui3/REPORT.md (fce7811) has the measurements this file follows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Issun</RootNamespace>
    <AssemblyName>Issun</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and carrying its own copy of the Windows App SDK, so the one
         .exe runs on a PC with nothing installed first, as the WPF build did.
         MSIX (the Microsoft Store's route) is a later step. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <ApplicationIcon>Assets\issun.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Windows App SDK's single-file targets require every file to be
         unpacked ("PublishSingleFile requires IncludeAllContentForSelfExtract
         for Dll SxS redirection"), so a published .exe unpacks into
         %TEMP%\.net\Issun\<hash> on first run. StaleUnpacks deletes the ones
         earlier builds left. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <!-- Also required for a single file: it builds the resources.pri that
         WinUI reads its XAML from, embedded in the .exe. No MSIX is made. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- WinUI finds its compiled XAML and styles in <exe name>.pri, or else in
         resources.pri. Named after the exe (Issun.pri), a renamed copy, such
         as a release download (Issun-0.1.0-b88-....exe), found none: every
         ThemeResource failed and no view would load (seen 12 Nov 2026). The
         generic name works whatever the .exe is called. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole Windows App SDK, as PowerToys references it, though it also
         brings the AI, ML, Search and Widgets packages Issun doesn't use
         (onnxruntime, DirectML, the semantic index: about 25 MB of the .exe).
         The toolkit's SettingsControls below asks for Microsoft.WindowsAppSDK
         1.6 or later; with only the WinUI and Runtime packages referenced,
         NuGet satisfied that with 1.6's own copy beside 2.6.5's. The owner
         chose the size for the real SettingsCard, 12 Nov 2026 ("switch"). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <!-- Windows 11 Settings' rows: SettingsCard and SettingsExpander, which
         WinUI itself lacks and Microsoft's settings guidance points to. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Issun.Core\Issun.Core.csproj" />
  </ItemGroup>

</Project>
