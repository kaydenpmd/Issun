<Window x:Class="Issun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Issun.Views"
        Title="Issun"
        Icon="/Assets/issun.ico"
        Width="560" Height="820"
        MinWidth="520" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <!-- No background: the Fluent theme gives the window Mica on Windows 11,
         and the cards inside are drawn as layers over it. -->
    <v:MainView x:Name="View" />
</Window>
