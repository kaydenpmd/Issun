<UserControl x:Class="Issun.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Issun.Views"
             xmlns:tk="using:CommunityToolkit.WinUI.Controls"
             x:DefaultBindMode="OneWay"
             IsTabStop="False">

    <!-- The whole window, top to bottom: now playing, status, pairing,
         settings, then the two collapsed sections. Everything scrolls; the
         window never needs to be taller than the screen. Carried over from
         the WPF build word for word and row for row. -->
    <ScrollViewer x:Name="Scroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  IsTabStop="False">
        <!-- MaxWidth 1000: Windows Settings' content column, measured maximized
             on 26H2 build 26300.9457 at 150% (cards 998 epx wide;
             design-research\microsoft\windows11-settings-content-width). No
             theme resource gives a page's width, so it is typed. It was 820,
             from Issun's first window, with no source. -->
        <!-- The Grid is only there to centre the column. Placed straight in
             the ScrollViewer, a column held to MaxWidth was centred by its
             content's natural width rather than the 1000 it's drawn at, so
             in a wide window it sat right of centre, the more so the narrower
             its content (the owner, 14 Nov 2026: "menu is off-center"; 665
             epx left and 257 right, maximized at 1920). Measured in a layout
             dump at 1908 wide: 551.5 from the left without the Grid, 454 with
             it, which is centred. -->
        <Grid>
        <StackPanel Margin="24,12,24,24" MaxWidth="1000">

            <!-- ───────────── Couldn't start ───────────── -->
            <Border Style="{StaticResource Card}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    Margin="0,8,0,4"
                    Visibility="{x:Bind v:Bind.Present(ViewModel.StartupError)}">
                <TextBlock Text="{x:Bind ViewModel.StartupError}" Style="{StaticResource RowTitle}" />
            </Border>

            <!-- ───────────── Now playing ───────────── -->
            <TextBlock Text="Now playing" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" />
            <!-- Laid out as Windows' own media card in Quick Settings, without
                 its app-name row above and its playback buttons below (26H2
                 build 26300.9457, measured 12 Nov 2026 at 150%;
                 design-research\microsoft\windows11-media-controls): title and
                 artist on the left, centred against the cover on the right.
                 Padding 24: that card puts its title and its cover about 24 to
                 25 effective pixels inside its edges, and the same 24 goes
                 above and below here, where its other rows were. No theme
                 resource gives a card's padding, so it is typed. -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover, or a placeholder when there is none. An
                         ImageBrush rather than an Image so the corners clip.

                         The hairline is the owner's policy for pictures (13 Nov
                         2026), not Windows': Quick Settings' media card draws
                         none. Width: one physical pixel at any scale, as Apple
                         Music for Windows draws its covers' (measured at 150%,
                         where 1 epx would be 1.5 px and WinUI drew 2).
                         Colour: the theme's ControlStrokeColorDefault, the
                         stroke an unfocused combo box and a pressed button
                         wear. Corners:
                         ControlCornerRadius, 4, which Microsoft Learn's
                         "Geometry" page gives to in-page elements. It is drawn
                         over the art, as Apple Music draws its own, so a cover
                         the same colour as the card still has an edge.

                         58 by 58: Windows' own media card in Quick Settings,
                         measured 12 Nov 2026 on 26H2 build 26300.9457 at 150%,
                         draws its cover 87 px square, 58 effective pixels. No
                         theme resource gives that size, so it is typed here
                         (design-research\microsoft\windows11-media-controls). -->
                    <Grid Grid.Column="1" Width="58" Height="58" VerticalAlignment="Center">
                        <!-- No cover: an empty square, as Ammy's (and Control Center's)
                             is, no symbol (the owner, 13 Nov 2026). Its fill is the one
                             WinUI gives its own empty picture, PersonPicture's
                             ControlAltFillColorQuarternary (generic.xaml, WinAppSDK
                             2.6.5), which shows on the card in both themes: #18000000 in
                             light and #12FFFFFF in dark, on the card's #B3FFFFFF and
                             #0DFFFFFF. It was SubtleFillColorSecondary, a hover fill, and
                             ControlFillColorDefault is the card's own colour in light.
                             No hairline on it: PersonPicture has one, but the owner
                             asked for none (13 Nov 2026), as Ammy's square has none;
                             the hairline below edges covers only. -->
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
                                Visibility="{x:Bind v:Bind.Hidden(ViewModel.HasCover)}" />
                        <!-- The cover, fitted, not cropped: one that isn't square
                             shows all of itself, centred in the square, rounded and
                             stroked at its own edges, with nothing behind it, as
                             Ammy and the iOS Lock Screen draw it (the owner, 14 Nov
                             2026: "i will not publish something that crops album
                             art"). Windows' Quick Settings crops; this departs from
                             it on purpose. Its size is its decoded pixels at the
                             screen's scale (MainViewModel.CoverWidth), so it is
                             drawn one to one. -->
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                Width="{x:Bind ViewModel.CoverWidth}" Height="{x:Bind ViewModel.CoverHeight}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind v:Bind.Visible(ViewModel.HasCover)}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind ViewModel.Cover}" Stretch="Fill" />
                            </Border.Background>
                        </Border>
                        <!-- One physical pixel, whatever the scale: MainView.xaml.cs sets
                             the thickness to 1 / RasterizationScale. -->
                        <Border x:Name="CoverHairline" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1" IsHitTestVisible="False"
                                Width="{x:Bind ViewModel.CoverWidth}" Height="{x:Bind ViewModel.CoverHeight}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Visibility="{x:Bind v:Bind.Visible(ViewModel.HasCover)}" />
                    </Grid>

                    <!-- The media card's two text styles: the title in Body
                         Strong (14 semibold) over the artist in Caption (12),
                         both in the primary text colour, with nothing between
                         them. Its title measured 10 effective pixels to the
                         cap, its artist 8.7. The 16 before the cover isn't
                         from it: its title was too short to show the gap. -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">

                        <!-- A track -->
                        <StackPanel Visibility="{x:Bind v:Bind.Visible(ViewModel.HasTrack)}">
                            <!-- One line, cut short with an ellipsis, never a second line
                                 (the owner, 14 Nov 2026: "truncate text instead of adding
                                 more lines"; it was two lines at most). The full title is
                                 the tooltip. The explicit badge sits beside the title
                                 rather than in it, so a long title's ellipsis comes before
                                 the badge and the badge stays: the Grid is left-aligned and
                                 sized to what it holds, so the badge follows a short title
                                 and ends the line after a long one's ellipsis. Its own
                                 RichTextBlock (Body Strong's size and weight) holds the
                                 space before it, in the title's font, and keeps it on the
                                 title's baseline, where iOS's Lock Screen puts the badge.

                                 The badge is Apple's: SF Pro's 🅴 (U+1F174), which is
                                 the SF Symbol e.square.fill at small scale. SF Pro
                                 can't ship here, and Segoe UI Symbol's 🅴, typed until
                                 13 Nov 2026, is a different design the owner turned
                                 down ("this explicit symbol looks like shit"), so it
                                 is drawn from SF Pro's proportions, measured from the
                                 rasterised glyph (design-research\apple\
                                 apple-music-windows-explicit-badge), in a 100-unit
                                 square: corners rounded 15; the E cut out of it,
                                 x 32.3-67.7, y 23.7-74.9, stem 10.1 wide, arms 8.2
                                 tall with round ends, the middle one 7.7 and ending
                                 at 66.2. A hole, so the card shows through it.
                                 Side 9.8: the square is SF Pro's cap height, and Body
                                 Strong is Segoe UI Variable at 14, whose cap height is
                                 1434/2048 of that. No theme resource gives a cap
                                 height. Preceded by a space, as the Lock Screen
                                 appends " %@"; in the title's colour, as there. -->
                            <Grid HorizontalAlignment="Left" ToolTipService.ToolTip="{x:Bind ViewModel.Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <RichTextBlock Grid.Column="1" Style="{StaticResource BodyRichTextBlockStyle}" FontWeight="SemiBold"
                                           TextWrapping="NoWrap" IsTextSelectionEnabled="False"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind v:Bind.Visible(ViewModel.IsExplicit)}">
                                <Paragraph>
                                    <Run Text="{x:Bind ViewModel.ExplicitSpace}" /><InlineUIContainer>
                                        <Path Width="9.8" Height="9.8" Stretch="Fill"
                                              Visibility="{x:Bind v:Bind.Visible(ViewModel.IsExplicit)}"
                                              Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                              AutomationProperties.Name="Explicit"
                                              Data="F0 M15,0 H85 A15,15 0 0 1 100,15 V85 A15,15 0 0 1 85,100 H15 A15,15 0 0 1 0,85 V15 A15,15 0 0 1 15,0 Z
                                                    M34.8,23.7 H63.6 A4.1,4.1 0 0 1 63.6,31.9 H42.4 V45.1 H62.3 A3.85,3.85 0 0 1 62.3,52.8 H42.4 V66.7 H63.6 A4.1,4.1 0 0 1 63.6,74.9 H34.8 A2.5,2.5 0 0 1 32.3,72.4 V26.2 A2.5,2.5 0 0 1 34.8,23.7 Z" />
                                    </InlineUIContainer>
                                </Paragraph>
                            </RichTextBlock>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Artist}" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.Artist}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <!-- No track -->
                        <TextBlock Text="Not playing" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Visibility="{x:Bind v:Bind.Hidden(ViewModel.HasTrack)}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────────── Status ───────────── -->
            <TextBlock Text="Status" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:StatusDot Status="{x:Bind ViewModel.PhoneStatus}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Source" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.PhoneStatus.Text}" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:StatusDot Status="{x:Bind ViewModel.DiscordStatus}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Discord" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.DiscordStatus.Text}" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:StatusDot Status="{x:Bind ViewModel.ReceiverStatus}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Receiver" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.ReceiverStatus.Text}" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <v:StatusDot Status="{x:Bind ViewModel.TailscaleStatus}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tailscale" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.TailscaleStatus.Text}" Style="{StaticResource RowDescription}" />
                            <!-- Below the text rather than beside it: Tailscale's
                                 advice can run to a whole command line. -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Turn on Funnel" Command="{x:Bind ViewModel.EnableFunnelCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                        Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferFunnel)}" />
                                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshTailscaleCommand}" Margin="0,0,12,0" />
                                <TextBlock Text="Working…" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Visibility="{x:Bind v:Bind.Visible(ViewModel.EnableFunnelCommand.IsRunning)}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TailscaleError}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                                       Visibility="{x:Bind v:Bind.Present(ViewModel.TailscaleError)}" />
                        </StackPanel>
                    </Grid>

                    <!-- What `tailscale funnel` said. On a tailnet that hasn't
                         allowed Funnel yet this is a link to the page that allows
                         it, so links are clickable. -->
                    <Border Margin="24,10,0,0" Padding="10,8" CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind v:Bind.Present(ViewModel.FunnelOutput)}">
                        <TextBlock v:LinkTextBlock.Text="{x:Bind ViewModel.FunnelOutput}" Style="{StaticResource MonoBlock}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ───────────── Connect your source ───────────── -->
            <!-- "Connect your source", and the setup page's own cards (the
                 owner, 12 Nov 2026: parity between the two, favouring setup). -->
            <TextBlock Text="Connect your source" Style="{StaticResource SectionHeader}" />
            <ContentControl x:Name="PairingHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />

            <!-- ───────────── Settings ───────────── -->
            <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />

            <!-- The whole card is the button, as Windows 11 Settings' cards
                 that open a page are. The owner's words and layout, 12 Nov 2026.
                 Setup opens in a window of its own, so not the chevron (Settings'
                 sign for a page in the same window) but the sign Settings puts on
                 a card that opens another window, as on Sound's "More sound
                 settings": E8A7, Open in new window. -->
            <tk:SettingsCard Header="Set up again" Command="{x:Bind ViewModel.OpenSetupCommand}" IsClickEnabled="True"
                             Style="{StaticResource Row}">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Public now playing" Style="{StaticResource Row}">
                <tk:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="Lets a web page read what you're playing from this PC's address without the key." TextWrapping="Wrap" />
                        <!-- In the caution colour and semibold while it's on. -->
                        <TextBlock Text="Anyone who has the address can then see what you're listening to." TextWrapping="Wrap"
                                   Visibility="{x:Bind v:Bind.Hidden(ViewModel.PublicRead)}" />
                        <TextBlock Text="Anyone who has the address can then see what you're listening to." TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"
                                   Visibility="{x:Bind v:Bind.Visible(ViewModel.PublicRead)}" />
                    </StackPanel>
                </tk:SettingsCard.Description>
                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind ViewModel.PublicRead, Mode=TwoWay}"
                          AutomationProperties.Name="Public now playing" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Port" Style="{StaticResource Row}"
                             Description="Where Issun listens on this PC. Tailscale Funnel has to point at the same port.">
                <TextBox Width="90" Text="{x:Bind ViewModel.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Port" />
            </tk:SettingsCard>

            <!-- Above Apply, and applied by it, as the settings above it are
                 (the owner, 12 Nov 2026). -->
            <tk:SettingsCard Header="Start with Windows" Style="{StaticResource Row}">
                <tk:SettingsCard.Description>
                    <!-- No description (the owner, 12 Nov 2026); only an error, when
                         Windows didn't take the change. -->
                    <TextBlock Text="{x:Bind ViewModel.StartWithWindowsError}" Style="{StaticResource ErrorText}"
                               Visibility="{x:Bind v:Bind.Present(ViewModel.StartWithWindowsError)}" />
                </tk:SettingsCard.Description>
                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind ViewModel.StartWithWindowsField, Mode=TwoWay}"
                          AutomationProperties.Name="Start with Windows" />
            </tk:SettingsCard>

            <StackPanel Padding="2,8,2,4" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apply" Command="{x:Bind ViewModel.ApplySettingsCommand}"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="88" Margin="0,0,8,0" />
                    <Button Content="Undo changes" Command="{x:Bind ViewModel.RevertSettingsCommand}" Margin="0,0,12,0"
                            Visibility="{x:Bind v:Bind.Visible(ViewModel.SettingsDirty)}" />
                    <TextBlock Text="{x:Bind ViewModel.SettingsSaved.Text}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.SettingsErrors}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                           Visibility="{x:Bind v:Bind.Present(ViewModel.SettingsErrors)}" />
            </StackPanel>



            <!-- ───────────── Diagnostics ───────────── -->
            <!-- SettingsExpander, as Windows 11 Settings' rows that open (the
                 owner, 12 Nov 2026), the title alone (its description went the
                 same day). What it opens to is one card of free-form content,
                 left-aligned, the toolkit's way of holding it. -->
            <tk:SettingsExpander Header="Diagnostics" IsExpanded="{x:Bind ViewModel.DiagnosticsExpanded, Mode=TwoWay}"
                                 Margin="0,22,0,4">
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="The source's last report" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagSummary}" Style="{StaticResource MonoBlock}" Margin="0,4,0,0" />

                    <TextBlock Text="Check-in history" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.UptimeSummary}" Style="{StaticResource MonoBlock}" TextWrapping="NoWrap" Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Refresh history" Command="{x:Bind ViewModel.RefreshUptimeCommand}" Margin="0,0,8,0" />
                        <Button Content="Open log folder" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- ───────────── Log ───────────── -->
            <tk:SettingsExpander Header="Log" IsExpanded="{x:Bind ViewModel.LogExpanded, Mode=TwoWay}"
                                 Margin="0,0,0,4">
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" Height="320" AcceptsReturn="True"
                             FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource CaptionTextBlockFontSize}"
                             TextWrapping="Wrap" TextAlignment="Left"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Log" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy log" Command="{x:Bind ViewModel.CopyLogCommand}" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Bind ViewModel.LogCopied.Text}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneTime}" Style="{StaticResource Caption}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
