<UserControl x:Class="Issun.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Issun.Views"
             xmlns:tk="using:CommunityToolkit.WinUI.Controls"
             x:DefaultBindMode="OneWay"
             IsTabStop="False">

    <!-- The whole window, top to bottom: now playing, status, pairing,
         settings, then the two collapsed sections. Everything scrolls; the
         window never needs to be taller than the screen. Carried over from
         the WPF build word for word and row for row. -->
    <ScrollViewer x:Name="Scroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  IsTabStop="False">
        <StackPanel Margin="24,12,24,24" MaxWidth="820">

            <!-- ───────────── Couldn't start ───────────── -->
            <Border Style="{StaticResource Card}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    Margin="0,8,0,4"
                    Visibility="{x:Bind v:Bind.Present(ViewModel.StartupError)}">
                <TextBlock Text="{x:Bind ViewModel.StartupError}" Style="{StaticResource RowTitle}" />
            </Border>

            <!-- ───────────── Now playing ───────────── -->
            <TextBlock Text="Now playing" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" />
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover, or a placeholder when there is none. An
                         ImageBrush rather than an Image so the corners clip.

                         The hairline is Windows 11's own convention for a
                         surface edge, and every value comes from Windows rather
                         than from here. Width 1: Microsoft Learn, "Layering and
                         elevation", gives every surface a stroke width of 1.
                         Colour: the theme's ControlStrokeColorDefault, the same
                         stroke Windows puts on buttons and combo boxes. Corners:
                         ControlCornerRadius, 4, which Microsoft Learn's
                         "Geometry" page gives to in-page elements. It is drawn
                         over the art, as Apple Music draws its own, so a cover
                         the same colour as the card still has an edge. -->
                    <Grid Width="112" Height="112" VerticalAlignment="Top">
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       AutomationProperties.Name="No cover" />
                        </Border>
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                Visibility="{x:Bind v:Bind.Visible(ViewModel.HasCover)}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind ViewModel.Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1" IsHitTestVisible="False"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">

                        <!-- A track -->
                        <StackPanel Visibility="{x:Bind v:Bind.Visible(ViewModel.HasTrack)}">
                            <!-- Two lines at most: some titles carry every remix credit.
                                 An explicit track's title ends in a typed 🅴;
                                 see NowPlayingText.CardTitle. -->
                            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.Title}" />
                            <TextBlock Text="{x:Bind ViewModel.Artist}" Style="{StaticResource BodyTextBlockStyle}" Margin="0,2,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <!-- No track -->
                        <StackPanel Visibility="{x:Bind v:Bind.Hidden(ViewModel.HasTrack)}">
                            <TextBlock Text="Not playing" Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.NothingPlayingDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>

                        <v:WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{x:Bind ViewModel.SourceVersion}" Style="{StaticResource Caption}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind v:Bind.Present(ViewModel.SourceVersion)}"
                                       Margin="0,0,12,0" />
                            <TextBlock Text="{x:Bind ViewModel.OnDiscord}" Style="{StaticResource Caption}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind v:Bind.Present(ViewModel.OnDiscord)}" />
                        </v:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────────── Status ───────────── -->
            <TextBlock Text="Status" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:StatusDot Status="{x:Bind ViewModel.PhoneStatus}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Source" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.PhoneStatus.Text}" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:StatusDot Status="{x:Bind ViewModel.DiscordStatus}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Discord" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.DiscordStatus.Text}" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:StatusDot Status="{x:Bind ViewModel.ReceiverStatus}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Receiver" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.ReceiverStatus.Text}" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <v:StatusDot Status="{x:Bind ViewModel.TailscaleStatus}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tailscale" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.TailscaleStatus.Text}" Style="{StaticResource RowDescription}" />
                            <!-- Below the text rather than beside it: Tailscale's
                                 advice can run to a whole command line. -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Turn on Funnel" Command="{x:Bind ViewModel.EnableFunnelCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                        Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferFunnel)}" />
                                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshTailscaleCommand}" Margin="0,0,12,0" />
                                <TextBlock Text="Working…" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Visibility="{x:Bind v:Bind.Visible(ViewModel.EnableFunnelCommand.IsRunning)}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TailscaleError}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                                       Visibility="{x:Bind v:Bind.Present(ViewModel.TailscaleError)}" />
                        </StackPanel>
                    </Grid>

                    <!-- What `tailscale funnel` said. On a tailnet that hasn't
                         allowed Funnel yet this is a link to the page that allows
                         it, so links are clickable. -->
                    <Border Margin="24,10,0,0" Padding="10,8" CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind v:Bind.Present(ViewModel.FunnelOutput)}">
                        <TextBlock v:LinkTextBlock.Text="{x:Bind ViewModel.FunnelOutput}" Style="{StaticResource MonoBlock}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ───────────── Connect your source ───────────── -->
            <!-- "Connect your source", and the setup page's own cards (the
                 owner, 12 Nov 2026: parity between the two, favouring setup). -->
            <TextBlock Text="Connect your source" Style="{StaticResource SectionHeader}" />
            <ContentControl x:Name="PairingHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />

            <!-- ───────────── Settings ───────────── -->
            <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />

            <!-- The whole card is the button, as Windows 11 Settings' cards
                 that open a page are. The owner's words and layout, 12 Nov 2026.
                 Setup opens in a window of its own, so not the chevron (Settings'
                 sign for a page in the same window) but the sign Settings puts on
                 a card that opens another window, as on Sound's "More sound
                 settings": E8A7, Open in new window. -->
            <tk:SettingsCard Header="Set up again" Command="{x:Bind ViewModel.OpenSetupCommand}" IsClickEnabled="True"
                             Style="{StaticResource Row}">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Discord application ID" Style="{StaticResource Row}"
                             Description="From your application in the Discord Developer Portal. Its name is what Discord shows after &quot;Listening to&quot;, so name it after where the music comes from, like Apple Music.">
                <TextBox Width="200" Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Discord application ID" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Public now playing" Style="{StaticResource Row}">
                <tk:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="Lets a web page read what you're playing from this PC's address without the key." TextWrapping="Wrap" />
                        <!-- In the caution colour and semibold while it's on. -->
                        <TextBlock Text="Anyone who has the address can then see what you're listening to." TextWrapping="Wrap"
                                   Visibility="{x:Bind v:Bind.Hidden(ViewModel.PublicRead)}" />
                        <TextBlock Text="Anyone who has the address can then see what you're listening to." TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"
                                   Visibility="{x:Bind v:Bind.Visible(ViewModel.PublicRead)}" />
                    </StackPanel>
                </tk:SettingsCard.Description>
                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind ViewModel.PublicRead, Mode=TwoWay}"
                          AutomationProperties.Name="Public now playing" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Port" Style="{StaticResource Row}"
                             Description="Where Issun listens on this PC. Tailscale Funnel has to point at the same port.">
                <TextBox Width="90" Text="{x:Bind ViewModel.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Port" />
            </tk:SettingsCard>

            <StackPanel Padding="2,8,2,4" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apply" Command="{x:Bind ViewModel.ApplySettingsCommand}"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="88" Margin="0,0,8,0" />
                    <Button Content="Undo changes" Command="{x:Bind ViewModel.RevertSettingsCommand}" Margin="0,0,12,0"
                            Visibility="{x:Bind v:Bind.Visible(ViewModel.SettingsDirty)}" />
                    <TextBlock Text="{x:Bind ViewModel.SettingsSaved.Text}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.SettingsErrors}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                           Visibility="{x:Bind v:Bind.Present(ViewModel.SettingsErrors)}" />
            </StackPanel>

            <tk:SettingsCard Header="Start with Windows" Style="{StaticResource Row}">
                <tk:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="Starts Issun in the tray when you sign in. Takes effect straight away." TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StartWithWindowsError}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                                   Visibility="{x:Bind v:Bind.Present(ViewModel.StartWithWindowsError)}" />
                    </StackPanel>
                </tk:SettingsCard.Description>
                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                          AutomationProperties.Name="Start with Windows" />
            </tk:SettingsCard>

            <!-- ───────────── Diagnostics ───────────── -->
            <Expander IsExpanded="{x:Bind ViewModel.DiagnosticsExpanded, Mode=TwoWay}" Margin="0,22,0,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <!-- The title alone: its description went on 12 Nov 2026, the owner's word. -->
                <Expander.Header>
                    <TextBlock Text="Diagnostics" Style="{StaticResource RowTitle}" />
                </Expander.Header>
                <StackPanel>
                    <TextBlock Text="The source's last report" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagSummary}" Style="{StaticResource MonoBlock}" Margin="0,4,0,0" />

                    <TextBlock Text="Check-in history" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.UptimeSummary}" Style="{StaticResource MonoBlock}" TextWrapping="NoWrap" Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Refresh history" Command="{x:Bind ViewModel.RefreshUptimeCommand}" Margin="0,0,8,0" />
                        <Button Content="Open log folder" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ───────────── Log ───────────── -->
            <Expander IsExpanded="{x:Bind ViewModel.LogExpanded, Mode=TwoWay}" Margin="0,0,0,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <!-- The title alone: its description went on 12 Nov 2026, the owner's word. -->
                <Expander.Header>
                    <TextBlock Text="Log" Style="{StaticResource RowTitle}" />
                </Expander.Header>
                <StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" Height="320" AcceptsReturn="True"
                             FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource CaptionTextBlockFontSize}"
                             TextWrapping="Wrap" TextAlignment="Left"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Log" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy log" Command="{x:Bind ViewModel.CopyLogCommand}" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Bind ViewModel.LogCopied.Text}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneTime}" Style="{StaticResource Caption}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
