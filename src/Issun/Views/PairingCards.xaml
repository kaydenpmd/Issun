<UserControl x:Class="Issun.Views.PairingCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Issun.Views"
             xmlns:tk="using:CommunityToolkit.WinUI.Controls"
             x:DefaultBindMode="OneWay"
             IsTabStop="False">

    <!-- Connect your source's cards: the QR code, the endpoint, the key, and
         whether a source is checking in. The setup window's page and the main
         window's section both show this one control (the owner, 12 Nov 2026:
         parity between the two, favouring the setup page), so a change to one
         is a change to both. Every word is the setup page's, carried over. -->
    <StackPanel>

        <!-- The QR code first, the owner's order. It and the key are blurred
             until Show, so a screenshot of the window doesn't give the key away. -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="QR code" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    <!-- Show/Hide, or Regenerate in its place while the code is
                         out of date (an edited endpoint, or a new key made
                         mid-edit): the code is blurred then, so Show's place
                         is where someone looks. Like Restart for an edited
                         field in Ammy. The owner's layout and word, 12 Nov 2026. -->
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.ToggleQrLabel}" Command="{x:Bind ViewModel.ToggleQrCommand}"
                            AutomationProperties.AutomationId="ToggleQr"
                            VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="64"
                            Visibility="{x:Bind v:Bind.Hidden(ViewModel.ShowReload)}" />
                    <Button Grid.Column="1" Content="Regenerate" Command="{x:Bind ViewModel.ReloadQrCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="64" AutomationProperties.AutomationId="ReloadQr"
                            Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowReload)}" />
                </Grid>
                <!-- The code you see is drawn by the compositor, as a child
                     visual of QrHost, through Win2D's Gaussian blur, so its
                     blur can be animated (PairingCards.xaml.cs). The Image
                     under it holds the sharp code at no opacity: without a
                     picture of its own an Image is offscreen to UI Automation
                     (sandbox, 13 Nov 2026), and screen readers would skip the
                     code. Siblings, as an element's opacity would apply to a
                     visual attached under it. -->
                <Grid Width="200" Height="200" Margin="0,12,0,0" HorizontalAlignment="Left"
                      Visibility="{x:Bind v:Bind.Visible(ViewModel.HasQr)}">
                    <Image Source="{x:Bind ViewModel.QrSource}" Stretch="Fill" Opacity="0"
                           AutomationProperties.Name="QR code with the address and key" />
                    <Border x:Name="QrHost" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- The endpoint: filled from Tailscale, editable either way. -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Endpoint" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Copy" Command="{x:Bind ViewModel.CopyEndpointCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Copy endpoint" />
                </Grid>
                <TextBox Text="{x:Bind ViewModel.EndpointText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                         AutomationProperties.Name="Endpoint" />
                <TextBlock Text="{x:Bind ViewModel.EndpointProblem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                           Visibility="{x:Bind v:Bind.Present(ViewModel.EndpointProblem)}" />
            </StackPanel>
        </Border>

        <!-- Vertical: the toolkit's own arrangement with the buttons under the
             header and key, so the key has the card's whole width and wraps
             there if a key is ever too long for it (the owner, 13 Nov 2026).
             Monospace, as the key was drawn before. -->
        <tk:SettingsCard Header="Key" Style="{StaticResource Row}" ContentAlignment="Vertical">
            <tk:SettingsCard.Description>
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.KeyDisplay}" Margin="0,3,0,0" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Text="{x:Bind ViewModel.KeyProblem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                               Visibility="{x:Bind v:Bind.Present(ViewModel.KeyProblem)}" />
                </StackPanel>
            </tk:SettingsCard.Description>
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Bind ViewModel.ToggleKeyLabel}" Command="{x:Bind ViewModel.ToggleKeyCommand}" Margin="0,0,8,0"
                        MinWidth="64" AutomationProperties.Name="Show or hide key" />
                <Button Content="Copy" Command="{x:Bind ViewModel.CopyKeyCommand}" AutomationProperties.Name="Copy key" />
                <!-- Makes a new key at once. "New key", the owner's words
                     for the main window's button, 12 Nov 2026. -->
                <Button Content="New key" Command="{x:Bind ViewModel.NewKeyCommand}" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="NewKey" />
            </StackPanel>
        </tk:SettingsCard>

        <!-- Whether a source is connected (the owner, 12 Nov 2026): Windows
             11's ProgressRing and "Waiting..." until one checks in, then the
             InfoBar's success mark (F136 in the success colour under F13E in
             the inverse text colour, 16 px, as WinUI's InfoBar draws it) and
             "Connected". -->
        <Border Style="{StaticResource Card}">
            <!-- Centred in the card's height, as a SettingsCard centres its content. -->
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Visibility="{x:Bind v:Bind.Hidden(ViewModel.SourceConnected)}">
                    <ProgressRing IsActive="{x:Bind v:Bind.Not(ViewModel.SourceConnected)}" Width="16" Height="16"
                                  MinWidth="16" MinHeight="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Waiting..." Style="{StaticResource RowDescription}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Visibility="{x:Bind v:Bind.Visible(ViewModel.SourceConnected)}">
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xF136;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="&#xF13E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16"
                                   Foreground="{ThemeResource TextFillColorInverseBrush}" />
                    </Grid>
                    <TextBlock Text="Connected" Style="{StaticResource RowDescription}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
