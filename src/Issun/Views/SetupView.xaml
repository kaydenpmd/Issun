<UserControl x:Class="Issun.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:Issun.Views"
             xmlns:vm="clr-namespace:Issun.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             d:DesignWidth="600" d:DesignHeight="560">

    <!-- The setup window: one page at a time above a row of Back, Next and
         Cancel. The structure is Microsoft's wizard guidance (the design
         library's microsoft/windows-setup-wizards): a main instruction on every
         page, no welcome page, Cancel becoming Close on the last page, buttons
         at least 120 wide, 8 apart. The main instruction is Windows 11's Title
         style (28/36 semibold), with 12 between it and the text below, per
         "Content layout and spacing". The cards, rows and type below that are
         the main window's, which follow Windows 11 Settings. -->
    <UserControl.Resources>
        <Style x:Key="MainInstruction" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PageBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,20" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="AccentFooterButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="24,20,24,12">

                <!-- ───────────── 1. Discord ───────────── -->
                <StackPanel Visibility="{Binding OnDiscordPage, Converter={StaticResource Visible}}">
                    <TextBlock Text="Connect to Discord" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="Issun shows your music on Discord through a Discord application of your own. Discord shows the application's name after &quot;Listening to&quot;, so name it after where the music comes from, like Apple Music." />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open Developer Portal" Command="{Binding OpenPortalCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Make an application" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Text="In the Discord Developer Portal, select New Application and give it a name." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBox x:Name="ClientIdBox" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" Margin="12,0,0,0"
                                         Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Discord application ID" />
                                <StackPanel>
                                    <TextBlock Text="Application ID" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDescription}"
                                               Text="Copy it from the application's General Information page and paste it here." />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding ClientIdProblem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                       Visibility="{Binding ClientIdProblem, Converter={StaticResource Present}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Ellipse DataContext="{Binding DiscordStatus}" Style="{StaticResource StatusDot}" />
                            <StackPanel>
                                <TextBlock Text="Discord" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding DiscordStatus.Text}" Style="{StaticResource RowDescription}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ───────────── 2. Tailscale ───────────── -->
                <StackPanel Visibility="{Binding OnTailscalePage, Converter={StaticResource Visible}}">
                    <TextBlock Text="Make this PC reachable" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="Your source sends to this PC over the internet through Tailscale Funnel. Tailscale is free, and needs an account." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse DataContext="{Binding TailscaleStatus}" Style="{StaticResource StatusDot}" />
                                <StackPanel>
                                    <TextBlock Text="Tailscale" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding TailscaleStatus.Text}" Style="{StaticResource RowDescription}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Get Tailscale" Command="{Binding GetTailscaleCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                                                Visibility="{Binding OfferInstall, Converter={StaticResource Visible}}" />
                                        <Button Content="Turn on Funnel" Command="{Binding EnableFunnelCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                                                Visibility="{Binding OfferFunnel, Converter={StaticResource Visible}}" />
                                        <Button Content="Check again" Command="{Binding CheckTailscaleCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <Border Margin="24,10,0,0" Padding="10,8" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding FunnelOutput, Converter={StaticResource Present}}">
                                <TextBlock v:LinkTextBlock.Text="{Binding FunnelOutput}" Style="{StaticResource MonoBlock}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowUnattended, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Turn on" Command="{Binding EnableUnattendedCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                    Visibility="{Binding OfferUnattended, Converter={StaticResource Visible}}" />
                            <Ellipse DataContext="{Binding UnattendedStatus}" Style="{StaticResource StatusDot}" />
                            <StackPanel>
                                <TextBlock Text="Run unattended" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding UnattendedStatus.Text}" Style="{StaticResource RowDescription}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding TailscaleError}" Style="{StaticResource ErrorText}" Margin="2,8,0,0"
                               Visibility="{Binding TailscaleError, Converter={StaticResource Present}}" />
                </StackPanel>

                <!-- ───────────── 3. Start with Windows ───────────── -->
                <StackPanel Visibility="{Binding OnStartPage, Converter={StaticResource Visible}}">
                    <TextBlock Text="Start with Windows" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="Issun passes your music on to Discord only while it's running. It runs in the notification area." />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Starts Issun in the tray when you sign in." Style="{StaticResource RowDescription}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ───────────── 4. Source ───────────── -->
                <StackPanel Visibility="{Binding OnSourcePage, Converter={StaticResource Visible}}">
                    <TextBlock Text="Connect your source" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="Put this address and key into your source's settings, or scan the QR code with it." />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding EndpointCopied.Text}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Copy" Command="{Binding CopyEndpointCommand}" AutomationProperties.Name="Copy endpoint" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Endpoint" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding EndpointUrl}" Style="{StaticResource MonoBlock}" Margin="0,3,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EndpointUrl}"
                                           Visibility="{Binding HasEndpoint, Converter={StaticResource Visible}}" />
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Visibility="{Binding HasEndpoint, Converter={StaticResource Hidden}}"
                                           Text="Not known yet. It appears here once Tailscale is running on this PC: go back a page to set it up." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding KeyCopied.Text}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="{Binding ToggleKeyLabel}" Command="{Binding ToggleKeyCommand}" Margin="0,0,8,0"
                                        MinWidth="64" AutomationProperties.Name="Show or hide key" />
                                <Button Content="Copy" Command="{Binding CopyKeyCommand}" AutomationProperties.Name="Copy key" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Key" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding KeyDisplay}" Style="{StaticResource MonoBlock}" Margin="0,3,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding ToggleQrLabel}" Command="{Binding ToggleQrCommand}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="QR code" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Holds the address and the key, for a source that can scan it." Style="{StaticResource RowDescription}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Drawn at whole device pixels so the modules stay sharp. -->
                            <Image Source="{Binding Qr}" Width="200" Height="200" Margin="0,12,0,0" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"
                                   AutomationProperties.Name="QR code with the address and key"
                                   Visibility="{Binding QrShown, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Ellipse DataContext="{Binding SourceStatus}" Style="{StaticResource StatusDot}" />
                            <StackPanel>
                                <TextBlock Text="Source" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding SourceStatus.Text}" Style="{StaticResource RowDescription}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Back, Next, Cancel: right-aligned, in that order. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,24,24">
            <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource FooterButton}" />
            <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource AccentFooterButton}" IsDefault="True"
                    Visibility="{Binding ShowNext, Converter={StaticResource Visible}}" />
            <Button Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" Style="{StaticResource FooterButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
