<UserControl x:Class="Issun.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Issun.Views"
             xmlns:tk="using:CommunityToolkit.WinUI.Controls"
             x:DefaultBindMode="OneWay"
             IsTabStop="False">

    <!-- The setup window: one page at a time above a row of Back, Next and
         Cancel. The structure is Microsoft's wizard guidance (the design
         library's microsoft/windows-setup-wizards): a main instruction on every
         page, no welcome page, buttons at least 120 wide, 8 apart. The main
         instruction is Windows 11's Title style (28/36 semibold), with 12
         between it and the text below, per "Content layout and spacing". The
         cards, rows and type below that are the main window's, which follow
         Windows 11 Settings.

         Every word on these pages is the owner's, from the wording page of
         12 Nov 2026 (claude.ai/artifact/BKtxXmKxc3ot9CSi7D2xRJ): where they
         left a field blank the text was taken out, not emptied. [text] marks
         each piece still theirs to write. Carried over word for word from the
         WPF build. -->
    <UserControl.Resources>
        <!-- A command link, Windows' title-and-note button, measured from a
             Windows 11 24H2 task dialog (design library, microsoft/command-links):
             an arrow about 20 px at x+3, the title about 16 px at x+34, the note
             about 12 px under it, ink 15 px below the top, no box at rest. The
             task dialog's #0078D7 becomes Fluent's accent text colour, since
             Windows draws no dark command link. The hover fill is
             SubtleFillColorSecondary: the task dialog's hover wasn't captured. -->
        <Style x:Key="CommandLink" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="3,9,8,9">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Arrow.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            <Setter Target="Body.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Arrow" Text="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       FontSize="20" Width="20" Margin="0,0,11,0" VerticalAlignment="Top"
                                       Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter x:Name="Body" Grid.Column="1" Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainInstruction" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PageBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,20" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="AccentFooterButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <!-- MaxWidth 1000, as the main window: Windows Settings' content
                 column (and PowerToys' PageMaxWidth). The footer below keeps
                 to the same column. -->
            <Grid Margin="24,20,24,12" MaxWidth="1000">
                <!-- The pages slide in a Frame, with WinUI's own navigation
                     transition (SetupView.xaml.cs says which). The four pages
                     below are written here, where x:Bind reaches them, and the
                     code moves each into the Frame's page as it's shown. -->
                <Frame x:Name="Pages" IsNavigationStackEnabled="False" IsTabStop="False" />

                <Grid x:Name="StepStore" Visibility="Collapsed">

                <!-- ───────────── 1. Discord ───────────── -->
                <StackPanel x:Name="DiscordStep">
                    <TextBlock Text="Connect to Discord" Style="{StaticResource MainInstruction}" Margin="0,0,0,20" />

                    <tk:SettingsCard Header="Make an application" Style="{StaticResource Row}"
                                     Description="In the Discord Developer Portal, select New Application and give it a name.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="1" FontFamily="{ThemeResource ContentControlThemeFontFamily}" Width="{ThemeResource SettingsCardHeaderIconMaxSize}"
                                      AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="1" />
                        </tk:SettingsCard.HeaderIcon>
                        <Button Content="Open Developer Portal" Command="{x:Bind ViewModel.OpenPortalCommand}" />
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Enter your application ID" Style="{StaticResource Row}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="2" FontFamily="{ThemeResource ContentControlThemeFontFamily}" Width="{ThemeResource SettingsCardHeaderIconMaxSize}"
                                      AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="2" />
                        </tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.Description>
                            <TextBlock Text="Copy it from the application's General Information page and paste it here." TextWrapping="Wrap" />
                        </tk:SettingsCard.Description>
                        <TextBox x:Name="ClientIdBox" Width="200"
                                 Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Discord application ID" />
                    </tk:SettingsCard>

                    <!-- Numbered, in the cards' icon space on the left (the
                         owner: "can't you put numbers in their own space on the
                         left yk more fancy"): a FontIcon holding the digit in
                         the text font, at the size and colour SettingsCard
                         gives its icon, and as wide as the card lets an icon be
                         (SettingsCardHeaderIconMaxSize), so every title starts in
                         the same place. This third card at the owner's ask of
                         13 Nov 2026 ("number the cards on the discord page and
                         add a third one that says "Make sure Discord is open"
                         with a button that says "Open""), their words. Next's
                         check needs Discord running; Open starts it. -->
                    <tk:SettingsCard Header="Make sure Discord is open" Style="{StaticResource Row}"
                                     Description="Discord needs to be open on this PC for Issun to connect to.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="3" FontFamily="{ThemeResource ContentControlThemeFontFamily}" Width="{ThemeResource SettingsCardHeaderIconMaxSize}"
                                      AutomationProperties.AccessibilityView="Content" AutomationProperties.Name="3" />
                        </tk:SettingsCard.HeaderIcon>
                        <Button Content="Open" Command="{x:Bind ViewModel.OpenDiscordCommand}" AutomationProperties.AutomationId="OpenDiscord" />
                    </tk:SettingsCard>

                    <!-- Next's answer from Discord, where the status card was
                         (the owner, 13 Nov 2026: "i want the error to be where
                         the status card is rn", then "put the error text in its
                         own card with a red ! or something"): WinUI's InfoBar at
                         Error severity, Windows' own bar for an error, with its
                         red icon and tinted fill, in the cards' column. No
                         title and no close button: the next Next or an edit to
                         the ID clears it. -->
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind v:Bind.Has(ViewModel.ClientIdProblem)}"
                             Message="{x:Bind ViewModel.ClientIdProblem}" />
                </StackPanel>

                <!-- ───────────── 2. Tailscale ───────────── -->
                <StackPanel x:Name="TailscaleStep">
                    <TextBlock Text="Make this PC reachable with a Tailscale Funnel" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="This step will give your PC a persistent address to connect to. Without one, you'll be stuck with a rotating IP address.&#x0a;Tailscale is a free service." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <v:StatusDot Status="{x:Bind ViewModel.TailscaleStatus}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tailscale" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{x:Bind ViewModel.TailscaleStatus.Text}" Style="{StaticResource RowDescription}" />
                                    <!-- Installing Tailscale: a command link whose note is the
                                         exact winget command it runs, so people see it before
                                         they click (the owner, 12 Nov 2026). The title is
                                         theirs to write; the command is the code's own. -->
                                    <Button Style="{StaticResource CommandLink}" Command="{x:Bind ViewModel.GetTailscaleCommand}"
                                            Margin="-3,8,0,0" AutomationProperties.AutomationId="InstallTailscale"
                                            Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferInstall)}">
                                        <StackPanel>
                                            <TextBlock Text="[text]" FontSize="16" />
                                            <TextBlock Text="{x:Bind ViewModel.InstallCommandText, Mode=OneTime}" FontSize="{StaticResource CaptionTextBlockFontSize}" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Turn on Funnel" Command="{x:Bind ViewModel.EnableFunnelCommand}"
                                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                                Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferFunnel)}" />
                                        <Button Content="Check again" Command="{x:Bind ViewModel.CheckTailscaleCommand}" />
                                    </StackPanel>
                                    <!-- While winget installs Tailscale: an indeterminate
                                         bar, as Windows Settings shows while it adds a
                                         feature, and a line of the owner's words. -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{x:Bind v:Bind.Visible(ViewModel.GetTailscaleCommand.IsRunning)}">
                                        <ProgressBar IsIndeterminate="True" />
                                        <TextBlock Text="[text]" Style="{StaticResource RowDescription}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Margin="24,10,0,0" Padding="10,8" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind v:Bind.Present(ViewModel.FunnelOutput)}">
                                <TextBlock v:LinkTextBlock.Text="{x:Bind ViewModel.FunnelOutput}" Style="{StaticResource MonoBlock}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowUnattended)}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <v:StatusDot Status="{x:Bind ViewModel.UnattendedStatus}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Run unattended" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{x:Bind ViewModel.UnattendedStatus.Text}" Style="{StaticResource RowDescription}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Turn on" Command="{x:Bind ViewModel.EnableUnattendedCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                    Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferUnattended)}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Bind ViewModel.TailscaleError}" Style="{StaticResource ErrorText}" Margin="2,8,0,0"
                               Visibility="{x:Bind v:Bind.Present(ViewModel.TailscaleError)}" />
                </StackPanel>

                <!-- ───────────── 3. Start with Windows ───────────── -->
                <StackPanel x:Name="StartStep">
                    <TextBlock Text="Launch Issun on startup?" Style="{StaticResource MainInstruction}" Margin="0,0,0,12" />

                    <!-- Yes and No radio buttons under the question (the owner,
                         12 Nov 2026: "radiobuttons for yes and no for the launch
                         at startup or whatever page would be perfect"), in place
                         of a checkbox card that repeated the title. The choice
                         applies as it's picked; Finish ends setup. -->
                    <RadioButton Content="Yes" GroupName="LaunchOnStartup" IsChecked="{x:Bind ViewModel.LaunchYes, Mode=TwoWay}" Margin="2,0,0,8"
                                 AutomationProperties.AutomationId="LaunchYes" />
                    <RadioButton Content="No" GroupName="LaunchOnStartup" IsChecked="{x:Bind ViewModel.LaunchNo, Mode=TwoWay}" Margin="2,0,0,0"
                                 AutomationProperties.AutomationId="LaunchNo" />
                </StackPanel>

                <!-- ───────────── 4. Source ───────────── -->
                <StackPanel x:Name="SourceStep">
                    <TextBlock Text="Connect your source" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="Complete these fields in the service that you're connecting to Issun." />

                    <!-- The cards are the main window's too (Views/PairingCards). -->
                    <ContentControl x:Name="PairingHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Back, Skip, Next, Cancel:
             right-aligned, in that order. Enter is Next and Escape is Cancel,
             as WPF's IsDefault and IsCancel made them; the accelerators' own
             tooltips are hidden, since they would add words to the window. -->
        <!-- In the page's 1000-wide column, so on a wide window the buttons stay
             under the page's right edge rather than at the window's. -->
        <Grid Grid.Row="1" Margin="24,12,24,24" MaxWidth="1000">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" Style="{StaticResource FooterButton}" />
            <!-- Skip, on every page (the owner, 13 Nov 2026): moves on without
                 the page's check; on the last page it ends setup. -->
            <Button Content="Skip" Command="{x:Bind ViewModel.SkipCommand}" Style="{StaticResource FooterButton}"
                    AutomationProperties.AutomationId="Skip" />
            <!-- While Next waits on a check (Discord's answer about the ID,
                 Tailscale's address), the label gives way to WinUI's
                 ProgressRing at 16 px, the size Connect your source's Waiting
                 ring uses (the owner, 13 Nov 2026: "replace the "next" text
                 with a spinner"). The button is disabled meanwhile, so the ring
                 takes the disabled accent button's text colour. The button
                 keeps its 120 width, so nothing beside it moves. -->
            <Button Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentFooterButton}"
                    AutomationProperties.Name="{x:Bind ViewModel.NextLabel}"
                    Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowNext)}" KeyboardAcceleratorPlacementMode="Hidden">
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.NextLabel}"
                               Visibility="{x:Bind v:Bind.Hidden(ViewModel.NextCommand.IsRunning)}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.NextCommand.IsRunning}" Width="16" Height="16" MinWidth="16" MinHeight="16"
                                  Foreground="{ThemeResource AccentButtonForegroundDisabled}"
                                  Visibility="{x:Bind v:Bind.Visible(ViewModel.NextCommand.IsRunning)}" />
                </Grid>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Content="{x:Bind ViewModel.CloseLabel}" Command="{x:Bind ViewModel.CloseCommand}" Style="{StaticResource FooterButton}"
                    KeyboardAcceleratorPlacementMode="Hidden">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
