<UserControl x:Class="Issun.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Issun.Views"
             x:DefaultBindMode="OneWay"
             IsTabStop="False">

    <!-- The setup window: one page at a time above a row of Back, Next and
         Cancel. The structure is Microsoft's wizard guidance (the design
         library's microsoft/windows-setup-wizards): a main instruction on every
         page, no welcome page, buttons at least 120 wide, 8 apart. The main
         instruction is Windows 11's Title style (28/36 semibold), with 12
         between it and the text below, per "Content layout and spacing". The
         cards, rows and type below that are the main window's, which follow
         Windows 11 Settings.

         Every word on these pages is the owner's, from the wording page of
         12 Nov 2026 (claude.ai/artifact/BKtxXmKxc3ot9CSi7D2xRJ): where they
         left a field blank the text was taken out, not emptied. [text] marks
         each piece still theirs to write. Carried over word for word from the
         WPF build. -->
    <UserControl.Resources>
        <!-- A command link, Windows' title-and-note button, measured from a
             Windows 11 24H2 task dialog (design library, microsoft/command-links):
             an arrow about 20 px at x+3, the title about 16 px at x+34, the note
             about 12 px under it, ink 15 px below the top, no box at rest. The
             task dialog's #0078D7 becomes Fluent's accent text colour, since
             Windows draws no dark command link. The hover fill is
             SubtleFillColorSecondary: the task dialog's hover wasn't captured. -->
        <Style x:Key="CommandLink" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3,9,8,9">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Arrow.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            <Setter Target="Body.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Arrow" Text="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       FontSize="20" Width="20" Margin="0,0,11,0" VerticalAlignment="Top"
                                       Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter x:Name="Body" Grid.Column="1" Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainInstruction" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PageBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,20" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="AccentFooterButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <Grid Margin="24,20,24,12">

                <!-- ───────────── 1. Discord ───────────── -->
                <StackPanel Visibility="{x:Bind v:Bind.Visible(ViewModel.OnDiscordPage)}">
                    <TextBlock Text="Connect to Discord" Style="{StaticResource MainInstruction}" Margin="0,0,0,20" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Make an application" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Text="In the Discord Developer Portal, select New Application and give it a name." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Developer Portal" Command="{x:Bind ViewModel.OpenPortalCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Application ID" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDescription}"
                                               Text="Copy this from the application's General Information page and paste it here." />
                                </StackPanel>
                                <TextBox x:Name="ClientIdBox" Grid.Column="1" Width="200" VerticalAlignment="Center" Margin="12,0,0,0"
                                         Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Discord application ID" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.ClientIdProblem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                       Visibility="{x:Bind v:Bind.Present(ViewModel.ClientIdProblem)}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <v:StatusDot Status="{x:Bind ViewModel.DiscordStatus}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DiscordStatus.Text}" Style="{StaticResource RowDescription}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ───────────── 2. Tailscale ───────────── -->
                <StackPanel Visibility="{x:Bind v:Bind.Visible(ViewModel.OnTailscalePage)}">
                    <TextBlock Text="Make this PC reachable with a Tailscale Funnel" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="This step will give your PC a persistent address to connect to. Without one, you'll be stuck with a rotating IP address.&#x0a;Tailscale is a free service." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <v:StatusDot Status="{x:Bind ViewModel.TailscaleStatus}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tailscale" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{x:Bind ViewModel.TailscaleStatus.Text}" Style="{StaticResource RowDescription}" />
                                    <!-- Installing Tailscale: a command link whose note is the
                                         exact winget command it runs, so people see it before
                                         they click (the owner, 12 Nov 2026). The title is
                                         theirs to write; the command is the code's own. -->
                                    <Button Style="{StaticResource CommandLink}" Command="{x:Bind ViewModel.GetTailscaleCommand}"
                                            Margin="-3,8,0,0" AutomationProperties.AutomationId="InstallTailscale"
                                            Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferInstall)}">
                                        <StackPanel>
                                            <TextBlock Text="[text]" FontSize="16" />
                                            <TextBlock Text="{x:Bind ViewModel.InstallCommandText, Mode=OneTime}" FontSize="12" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Turn on Funnel" Command="{x:Bind ViewModel.EnableFunnelCommand}"
                                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                                Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferFunnel)}" />
                                        <Button Content="Check again" Command="{x:Bind ViewModel.CheckTailscaleCommand}" />
                                    </StackPanel>
                                    <!-- While winget installs Tailscale: an indeterminate
                                         bar, as Windows Settings shows while it adds a
                                         feature, and a line of the owner's words. -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{x:Bind v:Bind.Visible(ViewModel.GetTailscaleCommand.IsRunning)}">
                                        <ProgressBar IsIndeterminate="True" />
                                        <TextBlock Text="[text]" Style="{StaticResource RowDescription}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Margin="24,10,0,0" Padding="10,8" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind v:Bind.Present(ViewModel.FunnelOutput)}">
                                <TextBlock v:LinkTextBlock.Text="{x:Bind ViewModel.FunnelOutput}" Style="{StaticResource MonoBlock}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowUnattended)}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <v:StatusDot Status="{x:Bind ViewModel.UnattendedStatus}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Run unattended" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{x:Bind ViewModel.UnattendedStatus.Text}" Style="{StaticResource RowDescription}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Turn on" Command="{x:Bind ViewModel.EnableUnattendedCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                    Visibility="{x:Bind v:Bind.Visible(ViewModel.OfferUnattended)}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Bind ViewModel.TailscaleError}" Style="{StaticResource ErrorText}" Margin="2,8,0,0"
                               Visibility="{x:Bind v:Bind.Present(ViewModel.TailscaleError)}" />
                </StackPanel>

                <!-- ───────────── 3. Start with Windows ───────────── -->
                <StackPanel Visibility="{x:Bind v:Bind.Visible(ViewModel.OnStartPage)}">
                    <TextBlock Text="Launch Issun on startup?" Style="{StaticResource MainInstruction}" Margin="0,0,0,12" />

                    <!-- Yes and No radio buttons under the question (the owner,
                         12 Nov 2026: "radiobuttons for yes and no for the launch
                         at startup or whatever page would be perfect"), in place
                         of a checkbox card that repeated the title. The choice
                         applies as it's picked; Finish ends setup. -->
                    <RadioButton Content="Yes" GroupName="LaunchOnStartup" IsChecked="{x:Bind ViewModel.LaunchYes, Mode=TwoWay}" Margin="2,0,0,8"
                                 AutomationProperties.AutomationId="LaunchYes" />
                    <RadioButton Content="No" GroupName="LaunchOnStartup" IsChecked="{x:Bind ViewModel.LaunchNo, Mode=TwoWay}" Margin="2,0,0,0"
                                 AutomationProperties.AutomationId="LaunchNo" />
                </StackPanel>

                <!-- ───────────── 4. Source ───────────── -->
                <StackPanel Visibility="{x:Bind v:Bind.Visible(ViewModel.OnSourcePage)}">
                    <TextBlock Text="Connect your source" Style="{StaticResource MainInstruction}" />
                    <TextBlock Style="{StaticResource PageBody}"
                               Text="Complete these fields in the service that you're connecting to Issun." />

                    <!-- The QR code first, the owner's order. It and the key are
                         blurred until Show, so a screenshot of this window
                         doesn't give the key away. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="QR code" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <!-- Show/Hide, or Regenerate in its place while the code is
                                     out of date (an edited endpoint, or a new key made
                                     mid-edit): the code is blurred then, so Show's place
                                     is where someone looks. Like Restart for an edited
                                     field in Ammy. The owner's layout and word, 12 Nov 2026. -->
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.ToggleQrLabel}" Command="{x:Bind ViewModel.ToggleQrCommand}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="64"
                                        Visibility="{x:Bind v:Bind.Hidden(ViewModel.ShowReload)}" />
                                <Button Grid.Column="1" Content="Regenerate" Command="{x:Bind ViewModel.ReloadQrCommand}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="64" AutomationProperties.AutomationId="ReloadQr"
                                        Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowReload)}" />
                            </Grid>
                            <Image Source="{x:Bind ViewModel.Qr}" Width="200" Height="200" Margin="0,12,0,0" HorizontalAlignment="Left"
                                   Stretch="Fill" AutomationProperties.Name="QR code with the address and key"
                                   Visibility="{x:Bind v:Bind.Visible(ViewModel.HasQr)}" />
                        </StackPanel>
                    </Border>

                    <!-- The endpoint: filled from Tailscale, editable either way. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Endpoint" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Copy" Command="{x:Bind ViewModel.CopyEndpointCommand}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Copy endpoint" />
                            </Grid>
                            <TextBox Text="{x:Bind ViewModel.EndpointText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                     AutomationProperties.Name="Endpoint" />
                            <TextBlock Text="{x:Bind ViewModel.EndpointProblem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                       Visibility="{x:Bind v:Bind.Present(ViewModel.EndpointProblem)}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Key" Style="{StaticResource RowTitle}" />
                                <v:BlurredText Text="{x:Bind ViewModel.KeyText}" Radius="{x:Bind ViewModel.KeyBlur}" Margin="0,3,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.KeyProblem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                           Visibility="{x:Bind v:Bind.Present(ViewModel.KeyProblem)}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="{x:Bind ViewModel.ToggleKeyLabel}" Command="{x:Bind ViewModel.ToggleKeyCommand}" Margin="0,0,8,0"
                                        MinWidth="64" AutomationProperties.Name="Show or hide key" />
                                <Button Content="Copy" Command="{x:Bind ViewModel.CopyKeyCommand}" AutomationProperties.Name="Copy key" />
                                <!-- Makes a new key at once; the owner's words go here. -->
                                <Button Content="[text]" Command="{x:Bind ViewModel.NewKeyCommand}" Margin="8,0,0,0"
                                        AutomationProperties.AutomationId="NewKey" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Whether a source is connected (the owner, 12 Nov 2026):
                         Windows 11's ProgressRing and "Waiting..." until one checks
                         in, then the InfoBar's success mark (F136 in the success
                         colour under F13E in the inverse text colour, 16 px, as
                         WinUI's InfoBar draws it) and "Connected". Next follows it. -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{x:Bind v:Bind.Hidden(ViewModel.SourceConnected)}">
                                <ProgressRing IsActive="{x:Bind v:Bind.Not(ViewModel.SourceConnected)}" Width="16" Height="16"
                                              MinWidth="16" MinHeight="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Waiting..." Style="{StaticResource RowDescription}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{x:Bind v:Bind.Visible(ViewModel.SourceConnected)}">
                                <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="&#xF136;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="&#xF13E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16"
                                               Foreground="{ThemeResource TextFillColorInverseBrush}" />
                                </Grid>
                                <TextBlock Text="Connected" Style="{StaticResource RowDescription}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Back, Skip (Tailscale and Connect your source), Next, Cancel:
             right-aligned, in that order. Enter is Next and Escape is Cancel,
             as WPF's IsDefault and IsCancel made them; the accelerators' own
             tooltips are hidden, since they would add words to the window. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,24,24">
            <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" Style="{StaticResource FooterButton}" />
            <!-- Skip: the way past for people without Tailscale, or not ready to connect a source. -->
            <Button Content="[text]" Command="{x:Bind ViewModel.SkipCommand}" Style="{StaticResource FooterButton}"
                    AutomationProperties.AutomationId="Skip"
                    Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowSkip)}" />
            <Button Content="{x:Bind ViewModel.NextLabel}" Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentFooterButton}"
                    Visibility="{x:Bind v:Bind.Visible(ViewModel.ShowNext)}" KeyboardAcceleratorPlacementMode="Hidden">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Content="{x:Bind ViewModel.CloseLabel}" Command="{x:Bind ViewModel.CloseCommand}" Style="{StaticResource FooterButton}"
                    KeyboardAcceleratorPlacementMode="Hidden">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
